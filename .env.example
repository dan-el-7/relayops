RELAYOPS_HOST=127.0.0.1
RELAYOPS_PORT=8000
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6387
FALKORDB_SSL=false
RELAYOPS_TENANTS=acme-retail,northstar-canary
RELAYOPS_DB_MODE=auto
RELAYOPS_EMBEDDING_MODE=auto
RELAYOPS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RELAYOPS_INDEX_MODE=auto
RELAYOPS_MAX_CATEGORIES=8
RELAYOPS_AGENT_MODE=scripted
OPENAI_MODEL=gpt-6-luna
# Optional. Only needed with RELAYOPS_AGENT_MODE=openai; never use Codex sign-in credentials here.
# OPENAI_API_KEY=
# Optional OpenAI-compatible Chat Completions provider.
# Supply a provider endpoint, model, and key only after verifying compatibility and cost.
# RELAYOPS_AGENT_MODE=chat_completions
# RELAYOPS_CHAT_API_KEY=
# RELAYOPS_CHAT_BASE_URL=
# RELAYOPS_CHAT_MODEL=
# Optional NVIDIA GPU local model, after ./scripts/setup-local-llm-gpu.sh:
# RELAYOPS_LOCAL_LLM_SERVER=.local-llm/cuda/b11430/llama-b11430/llama-server
# RELAYOPS_LOCAL_LLM_LIB_DIR=.local-llm/cuda/b11430/cudart-llama-b11430-bin-ubuntu-cuda-13.4-x64
